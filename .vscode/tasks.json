{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Runner: Start",
      "type": "shell",
      "command": ".github/runner/run.sh",
      "windows": {
        "command": "call .github\\runner\\run.cmd"
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "close": false },
      "problemMatcher": []
    },
    {
      "label": "Environment: Fetch",
      "type": "shell",
      "command": "gh auth switch --user tamfrost; gh api repos/tamfrost/basic-app/actions/workflows/fetch-environment.yaml/dispatches --method POST --field ref=ca-signing",
      "windows": {
        "command": "gh auth switch --user tamfrost; gh api repos/tamfrost/basic-app/actions/workflows/fetch-environment.yaml/dispatches --method POST --field ref=ca-signing",
        "options": { "shell": { "executable": "powershell.exe", "args": ["-Command"] } }
      },
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      "label": "Environment: Push",
      "type": "shell",
      "command": "npm run push-env",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      "label": "Workflow: mac",
      "type": "shell",
      "command": "gh workflow run publish.yaml --ref ca-signing --field run_on_mac=true",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      "label": "Workflow: linux",
      "type": "shell",
      "command": "gh workflow run publish.yaml --ref ca-signing --field run_on_mac=false",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      "label": "GitHub: Open page",
      "type": "shell",
      "command": "xdg-open ${input:githubPage}",
      "windows": {
        "command": "start chrome ${input:githubPage}",
        "options": { "shell": { "executable": "cmd.exe", "args": ["/C"] } }
      },
      "presentation": { "reveal": "never", "panel": "shared", "close": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "githubPage",
      "type": "pickString",
      "description": "Which GitHub page to open?",
      "options": [
        { "label": "Code", "value": "https://github.com/tamfrost/basic-app" },
        { "label": "Actions", "value": "https://github.com/tamfrost/basic-app/actions" },
        { "label": "Settings", "value": "https://github.com/tamfrost/basic-app/settings" },
        { "label": "Runners", "value": "https://github.com/tamfrost/basic-app/settings/actions/runners" },
        { "label": "Package", "value": "https://github.com/tamfrost/basic-app/pkgs/container/basic-app" }
      ]
    }
  ]
}
